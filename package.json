{
  "name": "benepass-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial read-only MCP server for the Benepass employee-web API",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "benepass-mcp": "dist/index.js"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
