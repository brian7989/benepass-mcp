{
  "name": "benepass-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial read-only MCP server for the Benepass employee-web API",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "benepass-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1118.0",
    "@modelcontextprotocol/server": "2.0.0",
    "atomically": "2.1.1",
    "env-paths": "4.0.0",
    "ky": "2.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
